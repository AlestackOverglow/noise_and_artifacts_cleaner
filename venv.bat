@echo off
chcp 65001 > nul

:: ---------------- НАСТРОЙКИ ----------------
:: Укажите точное имя вашего Python-файла
set "SCRIPT_NAME=clean_batch.py"

:: Укажите имя папки окружения (обычно venv или .venv)
set "VENV_NAME=venv"
:: -------------------------------------------

:: 1. Переходим в папку, где лежит этот bat-файл
cd /d "%~dp0"

:: 2. Проверяем, существует ли venv
if not exist "%VENV_NAME%\Scripts\activate.bat" (
    echo [ОШИБКА] Не найдена папка виртуального окружения "%VENV_NAME%"!
    echo Убедитесь, что bat-файл лежит рядом с папкой %VENV_NAME%.
    pause
    exit
)

:: 3. Активируем venv
echo [INFO] Активация окружения...
call "%VENV_NAME%\Scripts\activate.bat"

:: 4. Запускаем скрипт
echo [INFO] Запуск %SCRIPT_NAME%...
python "%SCRIPT_NAME%"

:: 5. Выключение (сработает, когда python закончит работу)
echo.
echo [INFO] Скрипт завершил работу.
echo [WARNING] ВЫКЛЮЧЕНИЕ КОМПЬЮТЕРА ЧЕРЕЗ 60 СЕКУНД...
echo (Чтобы отменить, закройте окно или наберите "shutdown /a" в консоли)

shutdown /s /t 60

:: Ожидание нажатия клавиши (опционально, можно убрать строку ниже, если хотите полной автоматизации)
:: pause